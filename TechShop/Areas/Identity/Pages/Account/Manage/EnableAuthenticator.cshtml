@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "2FA beállítása";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h4 class="fw-bold mb-4 text-dark pb-3 border-bottom border-light">Hitelesítő alkalmazás beállítása</h4>
<div class="row">
    <div class="col-md-10 col-lg-8">
        <p class="text-muted mb-4 small">A hitelesítő alkalmazás használatához kövesse az alábbi lépéseket:</p>
        <ol class="list-group list-group-numbered list-group-flush mb-4">
            <li class="list-group-item bg-transparent border-0 px-0 py-2 text-muted">Töltsön le egy hitelesítő alkalmazást (pl. Microsoft Authenticator, Google Authenticator).</li>
            <li class="list-group-item bg-transparent border-0 px-0 py-2 text-muted">Szkennelje be a QR-kódot, vagy írja be a kulcsot: <kbd class="bg-dark px-2">@Model.SharedKey</kbd></li>
            <li class="list-group-item bg-transparent border-0 px-0 py-2 text-muted">Írja be az alkalmazás által generált 6 jegyű kódot alább.</li>
        </ol>

        <div class="bg-light p-4 rounded-4 mb-4 text-center d-inline-block">
            <div id="qrCode" class="shadow-sm p-2 bg-white rounded-3"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </div>

        <form id="send-code" method="post">
            <div class="form-floating mb-4">
                <input asp-for="Input.Code" class="form-control bg-light border-0 rounded-4 px-4" autocomplete="off" placeholder="Kód" style="height: 60px;" />
                <label asp-for="Input.Code" class="text-muted ps-4">Ellenőrző kód</label>
                <span asp-validation-for="Input.Code" class="text-danger small fw-bold"></span>
            </div>
            <button type="submit" class="btn btn-premium w-100 py-3 rounded-4 shadow-sm text-uppercase fw-bold small">Megerősítés</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcode.js"></script>
    <script>new QRCode(document.getElementById("qrCode"), { text: "@Html.Raw(Model.AuthenticatorUri)", width: 160, height: 160 });</script>
}