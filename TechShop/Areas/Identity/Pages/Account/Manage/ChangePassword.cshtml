@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Jelszó biztonság";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="mb-5">
    <div class="d-flex align-items-center mb-4">
        <div class="bg-indigo-light rounded-circle p-2 me-3" style="background: rgba(99, 102, 241, 0.1);">
            <i class="bi bi-shield-lock fs-4 text-primary" style="color: var(--indigo-accent) !important;"></i>
        </div>
        <h4 class="fw-bold mb-0">Biztonsági hitelesítő adatok</h4>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form" method="post" class="row g-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold"></div>
        
        <div class="col-12">
            <div class="form-floating shadow-sm rounded-4 overflow-hidden mb-4">
                <input asp-for="Input.OldPassword" class="form-control border-0 bg-light px-4" autocomplete="current-password" placeholder="Old" style="height: 65px;" />
                <label asp-for="Input.OldPassword" class="text-muted ps-4">Jelenlegi jelszó</label>
            </div>
            <span asp-validation-for="Input.OldPassword" class="text-danger small fw-bold d-block mt-1 ms-2"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating shadow-sm rounded-4 overflow-hidden">
                <input asp-for="Input.NewPassword" class="form-control border-0 bg-light px-4" autocomplete="new-password" placeholder="New" style="height: 65px;" />
                <label asp-for="Input.NewPassword" class="text-muted ps-4">Új jelszó</label>
            </div>
            <span asp-validation-for="Input.NewPassword" class="text-danger small fw-bold d-block mt-1 ms-2"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating shadow-sm rounded-4 overflow-hidden">
                <input asp-for="Input.ConfirmPassword" class="form-control border-0 bg-light px-4" autocomplete="new-password" placeholder="Confirm" style="height: 65px;" />
                <label asp-for="Input.ConfirmPassword" class="text-muted ps-4">Megerősítés</label>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small fw-bold d-block mt-1 ms-2"></span>
        </div>
        
        <div class="col-12 mt-5 pt-3">
            <button type="submit" class="btn btn-premium px-5 py-3 shadow-sm text-uppercase fw-bold w-100 w-md-auto">
                Jelszó megváltoztatása <i class="bi bi-key-fill ms-2"></i>
            </button>
        </div>
    </form>
</div>