<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechShop</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --dark-slate: #0f172a;
            --indigo-accent: #6366f1;
            --bg-color: #f8fafc;
            --soft-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.08);
            --hover-shadow: 0 30px 60px -15px rgba(99, 102, 241, 0.2);
        }

        body { 
            background-color: var(--bg-color); 
            font-family: 'Outfit', sans-serif; 
            color: var(--dark-slate);
        }

        /* Glassmorphism Navbar */
        .glass-nav { 
            background: rgba(255, 255, 255, 0.75) !important;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.5);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
            transition: all 0.3s ease;
        }
        
        .navbar-brand { font-weight: 800; letter-spacing: -0.5px; font-size: 1.4rem; }
        .nav-link { font-weight: 600; color: #475569 !important; padding: 0.5rem 1rem !important; border-radius: 50px; transition: all 0.2s; }
        .nav-link:hover { background: rgba(99, 102, 241, 0.1); color: var(--indigo-accent) !important; }

        /* Gombok újraalkotva */
        .btn-premium {
            background-color: var(--dark-slate);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px 32px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }
        .btn-premium:hover {
            background-color: var(--indigo-accent);
            transform: translateY(-4px) scale(1.02);
            box-shadow: var(--hover-shadow);
            color: white;
        }

        .btn-outline-premium {
            background-color: transparent;
            color: var(--dark-slate);
            border: 2px solid #e2e8f0;
            border-radius: 50px;
            padding: 10px 28px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-outline-premium:hover {
            border-color: var(--dark-slate);
            background: var(--dark-slate);
            color: white;
        }

        /* Lebegő Kártyák */
        .premium-card {
            background: #ffffff;
            border-radius: 28px;
            border: none;
            box-shadow: var(--soft-shadow);
            transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
        }
        .premium-card:hover {
            transform: translateY(-12px);
            box-shadow: var(--hover-shadow);
        }

        /* Ikon konténer a kártyán belül */
        .icon-wrapper {
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
            border-radius: 20px;
            margin: 12px;
            padding: 40px 0;
            transition: all 0.5s ease;
        }
        .premium-card:hover .icon-wrapper {
            background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
            transform: scale(0.96);
        }
        .icon-wrapper i { transition: all 0.5s ease; }
        .premium-card:hover .icon-wrapper i { color: var(--indigo-accent) !important; transform: scale(1.1); }

        /* Szűrősáv */
        .filter-pill {
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(10px);
            border-radius: 50px;
            box-shadow: var(--soft-shadow);
            padding: 8px 12px;
            border: 1px solid rgba(255,255,255,0.8);
        }
        .filter-pill .form-control, .filter-pill .form-select {
            border: none;
            background: transparent;
            box-shadow: none;
            font-weight: 600;
            color: var(--dark-slate);
        }
        .filter-pill .form-select { cursor: pointer; }
        .filter-pill .input-group-text { background: transparent; border: none; }

        /* Valódi, prémium sötét dizájn a PRO termékeknek */
        .premium-card.pro-card {
            background: #0f172a !important; /* Mély sötétkék/fekete háttér */
            color: #f8fafc !important;
        }
        .pro-card h4 { color: #ffffff !important; }
        .pro-card .text-muted { color: #94a3b8 !important; }
        .pro-card .icon-wrapper {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%) !important;
        }
        .pro-card .icon-wrapper i { color: #cbd5e1 !important; }
        .pro-card .price-tag { color: #34d399 !important; } /* Smaragdzöld prémium árjelző */
        .pro-card .btn-dark {
            background: #ffffff !important;
            color: #0f172a !important;
        }
        .pro-card .btn-dark:hover {
            background: var(--indigo-accent) !important;
            color: white !important;
        }

        /* Prémium Lebegő Értesítés (Toast) */
        .premium-toast-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1055;
        }
        .premium-toast {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,0.8);
            border-radius: 20px;
            box-shadow: 0 20px 40px -10px rgba(99, 102, 241, 0.3);
            padding: 16px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .premium-toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        /* PRÉMIUM KOSÁR JELVÉNY (MICRO-BADGE) STÍLUS */
        .bg-premium-badge {
            background-color: var(--indigo-accent) !important;
            color: white !important;
            font-size: 0.65rem !important;
            font-weight: 800 !important;
            padding: 3px 6px !important;
            border: 2px solid #ffffff !important;
            box-shadow: 0 4px 10px rgba(99, 102, 241, 0.5) !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    @using Microsoft.AspNetCore.Http
    @using System.Text.Json
    @{
        int globalCartCount = 0;
        var cartSessionStr = Context.Session.GetString("cart");
        if (!string.IsNullOrEmpty(cartSessionStr))
        {
            try
            {
                var cartItems = JsonSerializer.Deserialize<List<JsonElement>>(cartSessionStr);
                if (cartItems != null)
                {
                    foreach (var item in cartItems)
                    {
                        if (item.TryGetProperty("Quantity", out var qtyProp))
                        {
                            globalCartCount += qtyProp.GetInt32();
                        }
                    }
                }
            }
            catch { /* Biztonsági elkapás, ha üres lenne a JSON */ }
        }
    }

    <header>
        <nav class="navbar navbar-expand-sm glass-nav sticky-top mb-5 py-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-lightning-fill"></i>
                        </div>
                        TechShop
                    </div>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center ms-4">
                        <li class="nav-item">
                            <a class="nav-link mx-1" asp-area="" asp-controller="Home" asp-action="Index">Főoldal</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link mx-1 position-relative d-flex align-items-center gap-1" asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-bag fs-5"></i> 
                                <span class="me-1">Kosár</span>
                                @if (globalCartCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-premium-badge animate-bounce">
                                        @globalCartCount
                                    </span>
                                }
                            </a>
                        </li>
                        
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item ms-3 ps-3 border-start">
                                <span class="navbar-text small fw-bold text-uppercase" style="color: #94a3b8; letter-spacing: 1px;">Admin</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link mx-1" asp-area="" asp-controller="OrderHandling" asp-action="Index">Rendelések</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link mx-1" asp-area="" asp-controller="Products" asp-action="Index">Termékek</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white text-muted mt-auto py-5 border-top border-light">
        <div class="container d-flex justify-content-between align-items-center">
            <p class="mb-0 fw-bold">&copy; 2026 TechShop.</p>
            <div class="d-flex gap-3 fs-5">
                <i class="bi bi-twitter-x cursor-pointer hover-text-dark"></i>
                <i class="bi bi-instagram cursor-pointer hover-text-dark"></i>
                <i class="bi bi-github cursor-pointer hover-text-dark"></i>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        var urlParams = new URLSearchParams(window.location.search);
        var isFiltered = urlParams.has('searchString') || urlParams.has('categoryId') || urlParams.has('sortOrder');
        AOS.init({ duration: 800, once: true, offset: 50, disable: isFiltered });
    </script>
    @RenderSection("Scripts", required: false)

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="premium-toast-container">
            <div id="uxToast" class="premium-toast">
                <div class="bg-success rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; flex-shrink: 0;">
                    <i class="bi bi-check-lg text-white fs-5"></i>
                </div>
                <div class="fw-bold" style="color: var(--dark-slate); font-size: 0.95rem;">
                    @TempData["SuccessMessage"]
                </div>
            </div>
        </div>
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const toast = document.getElementById('uxToast');
                setTimeout(() => { toast.classList.add('show'); }, 100);
                setTimeout(() => { toast.classList.remove('show'); }, 4000);
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="premium-toast-container" style="bottom: 100px;">
            <div id="infoToast" class="premium-toast">
                <div class="bg-warning rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; flex-shrink: 0;">
                    <i class="bi bi-info-lg text-dark fs-5"></i>
                </div>
                <div class="fw-bold" style="color: var(--dark-slate); font-size: 0.95rem;">
                    @TempData["InfoMessage"]
                </div>
            </div>
        </div>
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const infoToast = document.getElementById('infoToast');
                setTimeout(() => { infoToast.classList.add('show'); }, 150);
                setTimeout(() => { infoToast.classList.remove('show'); }, 4500); 
            });
        </script>
    }
</body>
</html>