@model TechShop.Models.Order

<div class="container py-4" data-aos="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bolder mb-1" style="letter-spacing: -1px;">Rendelés azonosító: <span style="color: var(--indigo-accent);">#@Model.OrderId</span></h2>
            <p class="text-muted mb-0"><i class="bi bi-calendar-event me-2"></i>@Model.OrderDate.ToString("yyyy. MMMM dd. - HH:mm")</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-premium rounded-pill py-2 px-4 shadow-sm fw-bold small"><i class="bi bi-arrow-left me-2"></i> Vissza</a>
    </div>

    <div class="row g-4">
        <div class="col-md-5 col-lg-4">
            <div class="premium-card p-4 mb-4 bg-white">
                <h5 class="fw-bold mb-4 text-dark pb-3 border-bottom border-light">Vásárló adatai</h5>
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                        <i class="bi bi-person fs-5 text-secondary"></i>
                    </div>
                    <div>
                        <span class="d-block text-muted small fw-bold">Név</span>
                        <span class="fw-bold fs-5 text-dark">@Model.CustomerName</span>
                    </div>
                </div>
                <div class="mt-4 pt-3 border-top border-light">
                    <span class="d-block text-muted small fw-bold mb-1">Fizetendő összeg</span>
                    <span class="fw-bolder fs-3 text-dark">@Model.TotalPrice.ToString("C0")</span>
                </div>
            </div>

            <div class="premium-card p-4 bg-white">
                <h5 class="fw-bold mb-3 text-dark pb-3 border-bottom border-light">Rendelés állapota</h5>
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <div class="mb-4">
                        <select name="newStatus" class="form-select bg-light border-0 py-3 rounded-4 shadow-sm fw-bold text-secondary">
                            <option value="Feldolgozás alatt" selected="@(Model.Status == "Feldolgozás alatt")">⏳ Feldolgozás alatt</option>
                            <option value="Futárnak átadva" selected="@(Model.Status == "Futárnak átadva")">🚚 Futárnak átadva</option>
                            <option value="Kiszállítva" selected="@(Model.Status == "Kiszállítva")">✅ Kiszállítva</option>
                            <option value="Törölve" selected="@(Model.Status == "Törölve")">❌ Törölve</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-premium w-100 py-2 rounded-4">Státusz frissítése</button>
                </form>
            </div>
        </div>

        <div class="col-md-7 col-lg-8">
            <div class="premium-card p-4 bg-white h-100">
                <h5 class="fw-bold mb-4 text-dark pb-3 border-bottom border-light">Megrendelt tételek (@Model.OrderItems.Count() db)</h5>
                
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.OrderItems)
                    {
                        bool isPro = item.Price > 400000;
                        <div class="list-group-item d-flex justify-content-between align-items-center py-4 border-light px-0">
                            <div class="d-flex align-items-center">
                                <div class="rounded-3 d-flex align-items-center justify-content-center me-4 shadow-sm" style="width: 60px; height: 60px; background: @(isPro ? "#0f172a" : "#f1f5f9"); color: @(isPro ? "#fff" : "#64748b");">
                                    <i class="bi bi-box-seam fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-bold fs-5 text-dark">@item.Product.Name</h6>
                                    <span class="text-muted small">Egységár: @item.Price.ToString("C0")</span>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge rounded-pill bg-light text-dark px-3 py-2 border shadow-sm fs-6">@item.Quantity db</span>
                                <div class="mt-2 fw-bold text-dark">@((item.Price * item.Quantity).ToString("C0"))</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>