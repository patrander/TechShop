@model IEnumerable<TechShop.Models.Order>
<div class="container py-4" data-aos="fade-in">
    <h2 class="fw-bolder mb-5" style="letter-spacing: -1px;"><i class="bi bi-activity text-muted me-2"></i> Beérkezett rendelések</h2>
    <div class="premium-card overflow-hidden">
        <table class="table align-middle table-hover mb-0 text-center table-borderless">
            <thead style="background: #f1f5f9;">
                <tr class="text-muted small text-uppercase" style="letter-spacing: 0.5px;">
                    <th class="py-3">ID</th>
                    <th class="py-3">Dátum</th>
                    <th class="py-3 text-start">Vásárló</th>
                    <th class="py-3">Státusz</th>
                    <th class="py-3 text-end pe-4">Végösszeg</th>
                    <th class="py-3">Művelet</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-bottom border-light">
                        <td class="fw-bold text-secondary">#@item.OrderId</td>
                        <td class="text-muted small">@item.OrderDate.ToString("yyyy. MM. dd. HH:mm")</td>
                        <td class="text-start fw-bold">@item.CustomerName</td>
                        <td>
                            @if (item.Status == "Feldolgozás alatt")
                            {
                                <span class="badge px-3 py-2 rounded-pill text-warning" style="background: rgba(245, 158, 11, 0.1);">@item.Status</span>
                            }
                            else
                            {

                                <span class="badge px-3 py-2 rounded-pill text-success" style="background: rgba(16, 185, 129, 0.1);">@item.Status</span>
                            }
                        </td>
                        <td class="text-end pe-4 fw-bold fs-5">@item.TotalPrice.ToString("C0")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-outline-premium btn-sm rounded-pill py-1 px-3 fs-7">Részletek</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>