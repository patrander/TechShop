@model TechShop.Models.Order
@{
    ViewData["Title"] = "Sikeres rendelés";
}
<div class="row justify-content-center py-5" data-aos="fade-up">
    <div class="col-md-7 text-center">
        <div class="premium-card p-5 bg-white">
            <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-4 shadow-sm" style="width: 80px; height: 80px;">
                <i class="bi bi-check-lg display-4"></i>
            </div>
            <h1 class="display-5 fw-bolder mb-3" style="letter-spacing: -1.5px;">Minden kész.</h1>
            <p class="lead text-muted mb-5">Köszönjük a vásárlást, <strong>@Model.CustomerName</strong>! A rendelés feldolgozását megkezdtük.</p>
            
            <div class="bg-light rounded-4 p-4 mx-auto mb-5 text-start" style="max-width: 450px;">
                <div class="d-flex justify-content-between mb-2 small text-muted">
                    <span>Rendelési azonosító</span>
                    <span class="fw-bold">#@Model.OrderId</span>
                </div>
                <div class="d-flex justify-content-between border-top pt-3 fw-bold fs-5 text-dark">
                    <span>Fizetett végösszeg</span>
                    <span style="color: var(--indigo-accent);">@Model.TotalPrice.ToString("C0")</span>
                </div>
            </div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-premium px-5 py-3">Vissza a főoldalra</a>
        </div>
    </div>
</div>