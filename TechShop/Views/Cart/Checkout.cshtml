@model TechShop.Models.Order
@{
    ViewData["Title"] = "Pénztár";
}

<div class="container py-5" data-aos="fade-in">
    <div class="d-flex align-items-center mb-5 pb-3 border-bottom border-light">
        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-4 shadow-sm" style="width: 60px; height: 60px;">
            <i class="bi bi-credit-card fs-3" style="color: var(--indigo-accent);"></i>
        </div>
        <div>
            <h2 class="fw-bolder mb-1" style="letter-spacing: -1px;">Biztonságos Fizetés</h2>
            <p class="text-muted mb-0 small">Kérjük, adja meg a szállítási és kapcsolattartási adatait.</p>
        </div>
    </div>

    <form asp-action="Checkout" method="post" id="checkoutForm">
        <div class="row g-5">
            <div class="col-lg-7">
                <div class="premium-card p-5 bg-white mb-4">
                    <h5 class="fw-bold mb-4 pb-2 border-bottom border-light">Kapcsolattartási adatok</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <div class="form-floating">
                                <input asp-for="CustomerName" class="form-control bg-light border-0 rounded-4 px-4" placeholder="Név" />
                                <label asp-for="CustomerName" class="text-muted ps-4">Teljes név</label>
                                <span asp-validation-for="CustomerName" class="text-danger small fw-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Email" class="form-control bg-light border-0 rounded-4 px-4" placeholder="Email" />
                                <label asp-for="Email" class="text-muted ps-4">E-mail cím</label>
                                <span asp-validation-for="Email" class="text-danger small fw-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="PhoneNumber" class="form-control bg-light border-0 rounded-4 px-4" placeholder="Telefon" />
                                <label asp-for="PhoneNumber" class="text-muted ps-4">Telefonszám</label>
                                <span asp-validation-for="PhoneNumber" class="text-danger small fw-bold"></span>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-4 pb-2 border-bottom border-light mt-5">Szállítási cím</h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="ZipCode" class="form-control bg-light border-0 rounded-4 px-4" placeholder="Irányítószám" />
                                <label asp-for="ZipCode" class="text-muted ps-4">Irányítószám</label>
                                <span asp-validation-for="ZipCode" class="text-danger small fw-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-floating">
                                <input asp-for="City" class="form-control bg-light border-0 rounded-4 px-4" placeholder="Város" />
                                <label asp-for="City" class="text-muted ps-4">Település</label>
                                <span asp-validation-for="City" class="text-danger small fw-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating">
                                <input asp-for="StreetAddress" class="form-control bg-light border-0 rounded-4 px-4" placeholder="Utca" />
                                <label asp-for="StreetAddress" class="text-muted ps-4">Utca, házszám, emelet, ajtó</label>
                                <span asp-validation-for="StreetAddress" class="text-danger small fw-bold"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="premium-card p-4 bg-white sticky-top" style="top: 110px;">
                    <h5 class="fw-bold mb-4">Rendelés összesítő</h5>
                    
                    <div class="list-group list-group-flush mb-4">
                        @foreach (var item in ViewBag.cart)
                        {
                            <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center border-light">
                                <div>
                                    <h6 class="mb-0 fw-bold" style="color: var(--dark-slate);">@item.Product.Name</h6>
                                    <small class="text-muted">@item.Quantity db x @item.Product.Price.ToString("C0")</small>
                                </div>
                                <span class="fw-bold">@((item.Product.Price * item.Quantity).ToString("C0"))</span>
                            </div>
                        }
                    </div>

                    <div class="bg-light p-4 rounded-4 mb-4">
                        <div class="d-flex justify-content-between mb-2 text-muted small fw-bold">
                            <span>Részösszeg</span>
                            <span>@ViewBag.total.ToString("C0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted small fw-bold">
                            <span>Szállítási díj</span>
                            <span class="text-success">Ingyenes</span>
                        </div>
                        <hr class="my-3 border-secondary opacity-25">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">Fizetendő:</span>
                            <span class="fs-3 fw-bolder" style="color: var(--indigo-accent);">@ViewBag.total.ToString("C0")</span>
                        </div>
                    </div>

                    <button id="checkoutSubmit" type="submit" class="btn btn-premium w-100 py-3 rounded-4 shadow-sm text-uppercase fw-bold small transition-all">
                        <span id="checkout-spinner" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                        <span id="checkout-text">Megrendelés elküldése <i class="bi bi-lock-fill ms-2"></i></span>
                    </button>
                    <p class="text-center text-muted small mt-3 mb-0"><i class="bi bi-shield-check me-1"></i> Adataidat SSL titkosítással védjük.</p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $('#checkoutForm').on('submit', function () {
            if ($(this).valid()) {
                $('#checkoutSubmit').addClass('disabled');
                $('#checkout-spinner').removeClass('d-none');
                $('#checkout-text').text('Feldolgozás alatt...');
            }
        });
    </script>
}