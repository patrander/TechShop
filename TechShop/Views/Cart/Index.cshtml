@{
    ViewData["Title"] = "Kosár";
}

<div class="container py-5" data-aos="fade-in">
    <h2 class="fw-bolder mb-5" style="letter-spacing: -1px;"><i class="bi bi-bag text-muted me-2"></i> Táska tartalma</h2>

    @if (ViewBag.cart != null && ViewBag.cart.Count > 0)
    {
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="premium-card p-4">
                    <div class="table-responsive">
                        <table class="table align-middle table-borderless mb-0">
                            <thead>
                                <tr class="text-muted small text-uppercase" style="letter-spacing: 0.5px;">
                                    <th scope="col" class="pb-3">Termék</th>
                                    <th scope="col" class="pb-3 text-center">Mennyiség</th>
                                    <th scope="col" class="pb-3 text-end">Összeg</th>
                                    <th scope="col" class="pb-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ViewBag.cart)
                                {
                                    <tr class="border-bottom border-light">
                                        <td class="py-4">
                                            <span class="d-block fw-bold fs-5 text-dark">@item.Product.Name</span>
                                            <span class="text-muted small">@item.Product.Price.ToString("C0") / db</span>
                                        </td>
                                        <td class="py-4 text-center">
                                            <span class="px-3 py-2 rounded-3 bg-light fw-bold">@item.Quantity</span>
                                        </td>
                                        <td class="py-4 text-end fw-bold fs-5">
                                            @((item.Product.Price * item.Quantity).ToString("C0"))
                                        </td>
                                        <td class="py-4 text-end">
                                            <a asp-controller="cart" asp-action="remove" asp-route-id="@item.Product.ProductId" class="text-danger fs-5 ms-3">
                                                <i class="bi bi-x-circle-fill"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="premium-card p-4 bg-white sticky-top" style="top: 110px;">
                    <h4 class="fw-bold mb-4">Összegzés</h4>
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Részösszeg</span>
                        <span>@ViewBag.total.ToString("C0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4 border-top pt-3 fw-bold fs-4 text-dark">
                        <span>Fizetendő</span>
                        <span style="color: var(--indigo-accent);">@ViewBag.total.ToString("C0")</span>
                    </div>
                    <a asp-controller="cart" asp-action="checkout" class="btn btn-premium w-100 py-3 rounded-4 shadow-sm text-uppercase fw-bold small">
                        Tovább a fizetéshez <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 120px; height: 120px;">
                <i class="bi bi-bag-x display-4 text-muted"></i>
            </div>
            <h3 class="fw-bold">A kosarad üres</h3>
            <p class="text-muted mb-4">Úgy tűnik, még nem választottál ki semmit.</p>
            <a asp-controller="home" asp-action="index" class="btn btn-outline-premium">Böngészés indítása</a>
        </div>
    }
</div>